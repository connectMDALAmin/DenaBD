# ==============================================================================
# DenaPawna (দেনাপাওনা) Environment Configuration
# ==============================================================================

# Public Client Configuration (Safe in Browser and Android APK):
# Firebase client SDK keys identify your Firebase project on Google Cloud.
# They are not secrets and are protected by Firestore and Storage Security Rules.
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="denapawna-prod.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="denapawna-prod"
VITE_FIREBASE_STORAGE_BUCKET="denapawna-prod.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Application URL (Auto-injected by AI Studio Cloud Run)
APP_URL="MY_APP_URL"

# ==============================================================================
# SENSITIVE SECRETS (NEVER EXPOSE IN FRONTEND CLIENT OR APK!)
# ==============================================================================
# The following must NEVER be included in frontend bundles, Android APKs, or Git:
# - FIREBASE_SERVICE_ACCOUNT_KEY (Server-side admin credential)
# - SMS_GATEWAY_API_SECRET (Bulk SMS provider secret)
# - PLAY_STORE_UPLOAD_KEYSTORE_PASSWORD
